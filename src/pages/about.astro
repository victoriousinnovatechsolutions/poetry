---
import Base from '@/layouts/Base.astro';
import { CONFIG } from '@/config.js';
import { EDUCATION, STAGES } from '@/data.js';

const { poetName, born, from } = CONFIG;
---

<Base title={`जीवन परिचय — ${poetName}`} description="कवि कमल भट्ट 'साहेब' का संपूर्ण जीवन परिचय — व्यक्तिगत विवरण, शिक्षा, काव्य यात्रा और साहित्यिक उपलब्धियाँ।" active="/about/">
  <section class="page-hero" data-reveal>
    <div class="wrap">
      <span class="eyebrow">जीवन परिचय</span>
      <h1>एक <span class="grad">रचनाकार</span> की कहानी</h1>
      <p>
        मध्य प्रदेश की मिट्टी से निकली एक आवाज़, जो समाज की पीड़ा, मातृभाषा का
        गौरव और जीवन के सच अपने काव्य में उतारती है।
      </p>
      <div class="crumbs"><a href="/">मुख्य पृष्ठ</a> / जीवन परिचय</div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap">
      <div class="about-grid">
        <div class="about-visual" data-reveal="left">
          <div class="about-photo">
            <img
              src="/assets/images/poet/poet-stage-podium.jpg"
              alt="कवि कमल भट्ट 'साहेब' मंच पर काव्य प्रस्तुति देते हुए"
            />
            <span class="photo-glow"></span>
            <span class="photo-name">अभिव्यक्ति 5.0 · काव्य प्रस्तुति</span>
            <span class="frame-line"></span>
          </div>
          <div class="about-badge">
            <b>5+</b>
            <span>प्रकाशित रचनाएँ</span>
          </div>
        </div>

        <div data-reveal="right">
          <div class="section-head">
            <span class="eyebrow">व्यक्तिगत विवरण</span>
            <h2 class="title">कवि कमल भट्ट <span class="grad">'साहेब'</span></h2>
            <p class="lede">
              हिंदी साहित्य के क्षेत्र में एक उभरता हुआ युवा रचनाकार, जिनकी कलम
              समाज के बेबस, मातृभाषा के प्रेम और जीवन के अनुभवों को आवाज़ देती है।
            </p>
            <p class="lede">
              मेलखेड़ा, तहसील शामगढ़, जिला मंदसौर (मध्य प्रदेश) में जन्मे कमल भट्ट ने
              कविता को केवल अभिव्यक्ति नहीं, बल्कि सामाजिक संवेदना और सांस्कृतिक
              पहचान का माध्यम बनाया है।
            </p>
          </div>

          <div class="info-list">
            <div class="info-item">
              <small>पूरा नाम</small>
              <b>{poetName}</b>
            </div>
            <div class="info-item">
              <small>जन्म तिथि</small>
              <b>{born}</b>
            </div>
            <div class="info-item">
              <small>जन्म स्थान</small>
              <b>मेलखेड़ा, मंदसौर (MP)</b>
            </div>
            <div class="info-item">
              <small>राष्ट्रीयता</small>
              <b>भारतीय</b>
            </div>
            <div class="info-item">
              <small>पिता का नाम</small>
              <b>श्री रामदयाल जी</b>
            </div>
            <div class="info-item">
              <small>माता का नाम</small>
              <b>श्रीमती गायत्री बाई</b>
            </div>
            <div class="info-item full">
              <small>पता</small>
              <b>{from}</b>
            </div>
            <div class="info-item full">
              <small>पेशा</small>
              <b>कवि एवं साहित्यकार — मुख्य रूप से साहित्यिक गतिविधियों में सक्रिय</b>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" data-reveal>
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">शिक्षा एवं शैक्षणिक योग्यता</span>
        <h2 class="title">
          ज्ञान की <span class="grad">सीढ़ियाँ</span>
        </h2>
        <p class="lede">कला, शिक्षा और हिंदी साहित्य — तीनों में उच्च शिक्षा प्राप्त।</p>
      </div>

      <div class="edu-grid">
        {EDUCATION.map((edu, i) => (
          <article class="edu-card hover-lift" data-reveal data-delay={i * 80}>
            <div class="edu-icon" aria-hidden="true">
              <span class="edu-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h4>{edu.degree}</h4>
            <div class="deg">{edu.field}</div>
            <p>{edu.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="stages" data-reveal>
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">काव्य यात्रा</span>
        <h2 class="title">
          अध्याय दर अध्याय — <span class="grad">रचना का विकास</span>
        </h2>
        <p class="lede">
          कविता अचानक नहीं आती — यह अनुभव, समय और संवेदना के चरणों से बनती है।
        </p>
      </div>

      <div class="timeline">
        {STAGES.map((stage, i) => (
          <div class="tl-item" data-reveal={i % 2 === 0 ? 'left' : 'right'}>
            <span class="dot" aria-hidden="true"></span>
            <div class="tl-card">
              <h4>{stage.chapter}</h4>
              <p>
                <b style="color:var(--gold)">{stage.poem}</b> — {stage.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" data-reveal="scale">
    <div class="wrap">
      <div class="cta-band">
        <h2>उनकी आवाज़ को सुनिए</h2>
        <p>काव्य संग्रह में हर अध्याय, हर भावना — एक क्लिक दूर।</p>
        <div class="hero-actions" style="justify-content:center;margin-top:26px">
          <a href="/poetry/" class="btn btn-gold">काव्य संग्रह खोलें</a>
          <a href="/awards/" class="btn btn-ghost">पुरस्कार देखें</a>
        </div>
      </div>
    </div>
  </section>
</Base>
