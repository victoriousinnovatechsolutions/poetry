---
import '../styles/global.css';
import { CONFIG } from '../config.js';
import PremiumHeader from '@/components/PremiumHeader.jsx';

const { poetName, poetNameLatin, nav } = CONFIG;

export interface BaseProps {
  title?: string;
  description?: string;
  active?: string;
  canonical?: string;
}

const year = 2026;
const title = Astro.props.title || CONFIG.title;
const description = Astro.props.description || CONFIG.description;
const canonical = Astro.props.canonical || `${CONFIG.domain}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="hi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e11d2a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hi_IN" />
    <meta property="og:image" content={`${CONFIG.domain}/assets/images/poet/poet-portrait-main.jpg`} />
    <meta property="og:site_name" content="कवि कमल भट्ट 'साहेब'" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${CONFIG.domain}/assets/images/poet/poet-portrait-main.jpg`} />
    <meta name="author" content={poetName} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: "कवि कमल भट्ट 'साहेब'",
        alternateName: ['Kavi Kamal Bhatt', 'Kamal Bhatt', 'कवि साहेब'],
        birthDate: '2000-05-23',
        birthPlace: {
          '@type': 'Place',
          name: 'मेलखेड़ा, शामगढ़, मंदसौर, मध्य प्रदेश, भारत',
        },
        jobTitle: 'कवि एवं साहित्यकार',
        description,
        url: CONFIG.domain,
        image: `${CONFIG.domain}/assets/images/poet/poet-portrait-main.jpg`,
        knowsLanguage: ['hi', 'en'],
        sameAs: [CONFIG.youtube, CONFIG.social.whatsapp],
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'मेलखेड़ा',
          addressRegion: 'मध्य प्रदेश',
          addressCountry: 'IN',
        },
      })}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Mukta:wght@300;400;500;600;700;800&family=Oswald:wght@400;500;600;700&family=Tiro+Devanagari+Hindi:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23e11d2a'/%3E%3Ctext x='16' y='23' font-size='18' text-anchor='middle' fill='%23ffffff' font-family='sans-serif'%3E%E0%A4%95%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">मुख्य सामग्री पर जाएँ</a>
    <PremiumHeader
      nav={nav}
      poetName={poetName}
      poetNameLatin={poetNameLatin}
      active={Astro.props.active}
      transparent={Astro.props.active === '/'}
      client:load
    />

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-about">
            <a href="/" class="brand">
              <span class="brand-mark">क</span>
              <span class="brand-text">
                <b>{poetName}</b>
                <small>{poetNameLatin}</small>
              </span>
            </a>
            <p>
              हिंदी काव्य की एक सच्ची, समाज-संवेदनशील आवाज़। मेलखेड़ा, मंदसौर,
              मध्य प्रदेश से — शब्दों के माध्यम से समाज, मातृभाषा, प्रेम और भक्ति का संवाद।
            </p>
            <div class="social-row">
              <a href={CONFIG.social.facebook} aria-label="Facebook" title="Facebook">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1Z" />
                </svg>
              </a>
              <a href={CONFIG.social.instagram} aria-label="Instagram" title="Instagram">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </a>
              <a href={CONFIG.social.youtube} aria-label="YouTube" title="YouTube">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="2" y="5" width="20" height="14" rx="4" />
                  <path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none" />
                </svg>
              </a>
              <a href={CONFIG.social.whatsapp} aria-label="WhatsApp" title="WhatsApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
                </svg>
              </a>
            </div>
          </div>

          <div>
            <h5>नेविगेशन</h5>
            <div class="footer-links">
              {nav.map(([href, label]) => <a href={href}>{label}</a>)}
            </div>
          </div>

          <div>
            <h5>काव्य क्षेत्र</h5>
            <div class="footer-links">
              <a href="/poetry/">समाज संवेदना</a>
              <a href="/poetry/">मातृभाषा</a>
              <a href="/poetry/">जीवन दर्शन</a>
              <a href="/poetry/">प्रेम और भक्ति</a>
            </div>
          </div>

          <div>
            <h5>संपर्क</h5>
            <div class="footer-links">
              <a href="tel:+917047895223">+91 70478 95223</a>
              <a href="mailto:info@kamalbhatt.com">info@kamalbhatt.com</a>
              <a href="/contact/">ग्राम मेलखेड़ा, तहसील शामगढ़, जिला मंदसौर (MP)</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {year} {poetName} — सर्वाधिकार सुरक्षित।</span>
          <span>❤ हिंदी काव्य और साहित्य को समर्पित</span>
        </div>
      </div>
    </footer>

    <div class="float-actions" aria-label="त्वरित संपर्क">
      <a class="float-btn wa" href={CONFIG.social.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp पर संपर्क करें">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.69 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.28.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.64 4.19 3.7.58.25 1.04.4 1.39.51.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
        </svg>
        <span>WhatsApp</span>
      </a>
      <a class="float-btn call" href="tel:+917047895223" aria-label="फ़ोन करें">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.09 4.2 2 2 0 0 1 4.08 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.1 9.9a16 16 0 0 0 6 6l1.26-1.24a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>Call</span>
      </a>
    </div>

    <button class="to-top" aria-label="ऊपर जाएँ">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      // Back-to-top visibility (header scroll state is owned by the React header)
      (() => {
        const toTop = document.querySelector('.to-top');
        const onScroll = () => {
          toTop?.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      })();

      // Scroll reveal — content is visible by default; animation only when observed.
      (() => {
        const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (rm) return;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('in');
            io.unobserve(en.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -50px' });
        const observeAll = () => {
          document.querySelectorAll('[data-reveal]:not(.in)').forEach((el) => io.observe(el));
        };
        setTimeout(observeAll, 0);
        const mo = new MutationObserver(() => observeAll());
        mo.observe(document.body, { childList: true, subtree: true });
      })();

      // Counters
      (() => {
        const nums = document.querySelectorAll('[data-count]');
        if (!nums.length) return;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target;
            const end = Number(el.dataset.count) || 0;
            const dur = 1400;
            const t0 = performance.now();
            const run = (t) => {
              const p = Math.min((t - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(end * eased));
              if (p < 1) requestAnimationFrame(run);
            };
            requestAnimationFrame(run);
            io.unobserve(el);
          });
        }, { threshold: 0.45 });
        nums.forEach((n) => io.observe(n));
      })();
    </script>
  </body>
</html>
